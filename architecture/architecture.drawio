        <mxCell id="e4" value="bypasses API Gateway - no payload limit, no Lambda cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5C6670;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#5C6670;labelBackgroundColor=#F7F8FA;" edge="1" parent="1" source="b2a" target="s3src"><mxGeometry relative="1" as="geometry" /></mxCell>
