<mxfile host="app.diagrams.net" agent="serverless-image-pipeline">
  <diagram name="Solution architecture" id="arch-1">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Serverless Image Processing Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5C6670&quot;&gt;S3 - SQS - Lambda - Step Functions - DynamoDB - CloudFront | AWS SAA graduation project&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="28" y="24" width="900" height="56" as="geometry" /></mxCell>
        <mxCell id="g1" value="1  Upload handshake - the browser asks for permission to upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#E1E5EA;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#16191D;arcSize=6;" vertex="1" parent="1"><mxGeometry x="28" y="96" width="1304" height="128" as="geometry" /></mxCell>
        <mxCell id="g2" value="2  Ingest - bytes go straight to S3, the event is buffered in a queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#E1E5EA;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#16191D;arcSize=6;" vertex="1" parent="1"><mxGeometry x="28" y="244" width="1304" height="172" as="geometry" /></mxCell>
        <mxCell id="g3" value="3  AWS Step Functions - Standard workflow, one execution per image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#E1E5EA;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#16191D;arcSize=6;" vertex="1" parent="1"><mxGeometry x="28" y="436" width="1304" height="212" as="geometry" /></mxCell>
        <mxCell id="g4" value="4  Delivery and operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#E1E5EA;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#16191D;arcSize=6;" vertex="1" parent="1"><mxGeometry x="28" y="668" width="1304" height="150" as="geometry" /></mxCell>
        <mxCell id="b1a" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;POST /api/uploads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6670;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="52" y="134" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="cf1" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;/api/* to API Gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="316" y="134" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="apigw" value="&lt;b&gt;Amazon API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;REST, throttled 25 rps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="134" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="pres" value="&lt;b&gt;Lambda: presign&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;returns pre-signed PUT URL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="844" y="134" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="ddb1" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;status = PENDING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C925D1;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1108" y="134" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="b2a" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;HTTPS PUT, signed URL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6670;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="52" y="282" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="s3src" value="&lt;b&gt;S3 source bucket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;uploads/ - expires after 30 d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="282" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="sqs" value="&lt;b&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;buffers bursts, enables retries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="844" y="282" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="cons" value="&lt;b&gt;Lambda: consumer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;StartExecution - idempotent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1108" y="282" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="val" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;decode + pixel-bomb guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="52" y="508" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="rsz1" value="&lt;b&gt;Resize: thumbnail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="304" y="504" width="248" height="42" as="geometry" /></mxCell>
        <mxCell id="rsz2" value="&lt;b&gt;Resize: medium&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="304" y="550" width="248" height="42" as="geometry" /></mxCell>
        <mxCell id="wm" value="&lt;b&gt;Watermark&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;burned onto the medium copy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="624" y="508" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="sto" value="&lt;b&gt;Store metadata&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;status = COMPLETED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="508" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="sns" value="&lt;b&gt;Amazon SNS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;publish job result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1096" y="508" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="s3dst" value="&lt;b&gt;S3 processed bucket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;private - OAC only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="52" y="710" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="cf2" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;/images/* - cached 1 year&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="316" y="710" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="view" value="&lt;b&gt;Viewer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5C6670&quot;&gt;three renditions over HTTPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6670;strokeWidth=2;fontSize=12;fontColor=#16191D;arcSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="710" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="par" value="PARALLEL STATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;dashed=1;fontSize=10;fontColor=#5C6670;arcSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="288" y="484" width="280" height="114" as="geometry" /></mxCell>
        <mxCell id="dlq" value="Dead-letter queue - after 3 receives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#98A2AE;strokeWidth=2;dashed=1;fontSize=10;fontColor=#5C6670;arcSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="844" y="372" width="200" height="34" as="geometry" /></mxCell>
        <mxCell id="ops" value="Observability and guardrails&#10;CloudWatch Logs + alarms on DLQ depth and workflow failures&#10;AWS X-Ray traces API Gateway to Lambda to Step Functions&#10;IAM least privilege per function - SSE on every bucket, queue and table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;dashed=1;fontSize=10;fontColor=#5C6670;arcSize=10;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="860" y="704" width="448" height="92" as="geometry" /></mxCell>
